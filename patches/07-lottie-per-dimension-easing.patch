-void LottieParser::getInterpolatorPoint(Point& pt)
+//The tangent of the first dimension in pt, of the second one (the same when not given) in second.
+void LottieParser::getInterpolatorPoint(Point& pt, Point& second)
 {
+    auto read = [&](float& first, float& other) {
+        if (peekType() == kArrayType) {
+            enterArray();
+            if (nextArrayValue()) {
+                first = other = getFloat();
+                if (nextArrayValue()) {
+                    other = getFloat();
+                    while (nextArrayValue()) getFloat();  //z: drop
+                }
+            }
+        } else first = other = getFloat();
+    };
     enterObject();
     while (auto key = nextObjectKey()) {
-        if (KEY_AS("x")) getValue(pt.x);
-        else if (KEY_AS("y")) getValue(pt.y);
+        if (KEY_AS("x")) read(pt.x, second.x);
+        else if (KEY_AS("y")) read(pt.y, second.y);
+        else skip();
     }
 }
 
 
