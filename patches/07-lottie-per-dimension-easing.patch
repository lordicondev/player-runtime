     T interpolate(LottieScalarFrame<T>* next, float frameNo)
     {
-        auto t = (frameNo - no) / (next->no - no);
-        if (interpolator) t = interpolator->progress(t);
+        auto t0 = (frameNo - no) / (next->no - no);
+        auto t = interpolator ? interpolator->progress(t0) : t0;
 
