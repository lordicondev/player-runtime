+//Per-dimension easing: After Effects gives each dimension of a multi-dimensional property
+//(scale, size...) its own speed curve. x follows t, y (and z) follow ty.
+template<typename T>
+static inline T lerpDimensions(const T& start, const T& end, float t, TVG_UNUSED float ty)
+{
+    return tvg::lerp(start, end, t);
+}
+
+static inline Point lerpDimensions(const Point& start, const Point& end, float t, float ty)
+{
+    return {tvg::lerp(start.x, end.x, t), tvg::lerp(start.y, end.y, ty)};
+}
+
+static inline Point3 lerpDimensions(const Point3& start, const Point3& end, float t, float ty)
+{
+    return {tvg::lerp(start.x, end.x, t), tvg::lerp(start.y, end.y, ty), tvg::lerp(start.z, end.z, ty)};
+}
