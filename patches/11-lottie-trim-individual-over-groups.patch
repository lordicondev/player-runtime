+//Shares one "trim individually" out over the shapes of the groups it spans: they take its range
+//as one sequence of paths, in stacking order, and each shape keeps its part of it.
+void LottieBuilder::shareTrim(RenderTrimGroup* trims)
+{
+    //the groups in stacking order (built bottom first), with their path lengths
+    Array<LottieGroup*> groups;
+    Array<float> lengths;
+    for (auto i = (int)trims->items.count - 1; i >= 0; --i) {
+        auto& item = trims->items[i];
+        bool known = false;
+        ARRAY_FOREACH(g, groups) known |= (*g == item.group);
+        if (known) continue;
+        auto& path = to<ShapeImpl>(item.shape)->rs.path;
+        auto m = item.shape->transform();
+        auto scale = sqrtf(fabsf(m.e11 * m.e22 - m.e12 * m.e21));
+        groups.push(item.group);
+        lengths.push(tvg::length(path.cmds.data, path.cmds.count, path.pts.data, path.pts.count) * scale);
+    }
+    if (groups.count < 2) return;
+
+    auto total = 0.0f;
+    ARRAY_FOREACH(l, lengths) total += *l;
+    if (total <= 0.0f) return;
+
+    //the range over the whole sequence: one interval, or two when it runs through the end
+    auto begin = trims->begin, end = trims->end;
+    _trimRange(begin, end);
+    float ranges[2][2];
+    auto count = 0;
+    if (begin <= end) {
+        ranges[count][0] = begin; ranges[count++][1] = end;
+    } else {
+        ranges[count][0] = begin; ranges[count++][1] = 1.0f;
+        ranges[count][0] = 0.0f; ranges[count++][1] = end;
+    }
+
+    auto start = 0.0f;
+    for (uint32_t i = 0; i < groups.count; ++i) {
+        auto from = start / total, to = (start + lengths[i]) / total;
+        start += lengths[i];
+        //the parts of the range on this group's paths, local to them
+        float local[2][2];
+        auto parts = 0;
+        for (auto r = 0; r < count; ++r) {
+            auto a = std::max(ranges[r][0], from), b = std::min(ranges[r][1], to);
+            if (b <= a || to <= from) continue;
+            local[parts][0] = (a - from) / (to - from);
+            local[parts++][1] = (b - from) / (to - from);
+        }
+        float lb = 0.0f, le = 0.0f;  //nothing drawn
+        if (parts == 1) {
+            lb = local[0][0];
+            le = local[0][1];
+        } else if (parts == 2) {  //through the end of this group's paths
+            lb = local[0][0];
+            le = local[1][1] + 1.0f;
+        }
+        ARRAY_FOREACH(item, trims->items) {
+            if (item->group == groups[i]) item->shape->trimpath(lb, le, false);
+        }
+    }
 }
 
 
