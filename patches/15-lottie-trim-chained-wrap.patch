     float begin = 0.0f;
     float end = 1.0f;
     bool simultaneous = true;
+    //further ranges kept from trims applied one after another (Lottie): begin/end pairs
+    static constexpr uint8_t MORE = 3;
+    float more[MORE * 2] = {};
+    uint8_t moreCnt = 0;
 
     bool valid()
     {
-        if (begin != 0.0f || end != 1.0f) return true;
+        if (begin != 0.0f || end != 1.0f || moreCnt > 0) return true;
         return false;
     }
 
+    bool same(const RenderTrimPath& rhs) const
+    {
+        if (!tvg::equal(begin, rhs.begin) || !tvg::equal(end, rhs.end) || simultaneous != rhs.simultaneous || moreCnt != rhs.moreCnt) return false;
+        for (uint8_t i = 0; i < moreCnt * 2; ++i) {
+            if (!tvg::equal(more[i], rhs.more[i])) return false;
+        }
+        return true;
+    }
+
     bool trim(const RenderPath& in, RenderPath& out) const;
 };
 
