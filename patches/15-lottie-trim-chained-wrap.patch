Subject: lottie: a trim within the segment an earlier trim left wraps inside that segment

Trims one after another on the same path compose: each cuts what the earlier one left. The
builder folded them into one range of the whole path (begin + length * inner range). When the
later trim's range, moved by its offset, wraps past the end of the segment the earlier trim left,
After Effects and lottie-web continue it at that segment's start, so it is two pieces of an open
path. The single folded range wrapped around the whole closed path instead and drew the part the
earlier trim had cut away (Lordicon: the flap of the doodle envelopes drawn as a wave, the
circles of the doodle avatars).

RenderTrimPath keeps up to three more ranges of the same path; trim() cuts the path by each.
The builder splits a wrapping inner range into two before mapping it onto the segment. When the
earlier trim keeps the whole path, the path stays closed and the range wraps as before.

Origin: Lordicon.
Base: thorvg/thorvg main 72a66415 (1.2.0). License: MIT, like ThorVG.
---
--- a/src/loaders/lottie/tvgLottieBuilder.cpp
+++ b/src/loaders/lottie/tvgLottieBuilder.cpp
@@ -841,20 +841,52 @@
     float begin, end;
     trimpath->segment(frameNo, begin, end, tween, exps);
 
-    if (to<ShapeImpl>(ctx->propagator)->rs.stroke) {
+    RenderTrimPath trim{begin, end, trimpath->type == LottieTrimpath::Type::Simultaneous};
+
+    //the trims below this one cut the segment it leaves. When that segment is a part of the path
+    //(an open path), a range of theirs that wraps past its end continues at its start, so it
+    //splits into two ranges. The whole path stays closed: the range wraps around it as it is.
+    if (auto stroke = to<ShapeImpl>(ctx->propagator)->rs.stroke) {
+        auto& inner = stroke->trim;
         auto length = fabsf(begin - end);
-        auto tmp = begin;
-        begin = (length * to<ShapeImpl>(ctx->propagator)->rs.stroke->trim.begin) + tmp;
-        end = (length * to<ShapeImpl>(ctx->propagator)->rs.stroke->trim.end) + tmp;
+        float ranges[(RenderTrimPath::MORE + 1) * 2];
+        uint8_t cnt = 0;
+        auto add = [&](float b, float e) {
+            if (cnt == RenderTrimPath::MORE + 1) return;
+            ranges[cnt * 2] = begin + length * b;
+            ranges[cnt * 2 + 1] = begin + length * e;
+            ++cnt;
+        };
+        auto split = [&](float b, float e) {
+            if (b > e) std::swap(b, e);
+            if (length >= 1.0f || e - b >= 1.0f || (b >= 0.0f && e <= 1.0f)) {
+                add(b, e);
+                return;
+            }
+            auto shift = floorf(b);
+            b -= shift;
+            e -= shift;
+            if (e <= 1.0f) add(b, e);
+            else {
+                add(b, 1.0f);
+                add(0.0f, e - 1.0f);
+            }
+        };
+        split(inner.begin, inner.end);
+        for (uint8_t i = 0; i < inner.moreCnt; ++i) split(inner.more[i * 2], inner.more[i * 2 + 1]);
+        trim.begin = ranges[0];
+        trim.end = ranges[1];
+        trim.moreCnt = cnt - 1;
+        for (uint8_t i = 2; i < cnt * 2; ++i) trim.more[i - 2] = ranges[i];
     }
 
-    ctx->propagator->trimpath(begin, end, trimpath->type == LottieTrimpath::Type::Simultaneous);
+    to<ShapeImpl>(ctx->propagator)->trimpath(trim);
     ctx->merging = nullptr;
 
     if (trimpath->type == LottieTrimpath::Type::Individual) {
         auto trims = new RenderTrimGroup;
-        trims->begin = begin;
-        trims->end = end;
+        trims->begin = trim.begin;
+        trims->end = trim.end;
         this->trims.push(trims);
         ctx->trims = trims;
     }
